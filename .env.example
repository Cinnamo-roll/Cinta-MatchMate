# ==================== 必填 ====================

# MySQL 管理员密码（仅数据库容器使用）
DB_ROOT_PASSWORD=

# MatchMate 应用数据库账号
DB_USERNAME=matchmate
DB_PASSWORD=

# Redis 密码
REDIS_PASSWORD=

# ==================== 阿里云 OSS（文件上传） ====================
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_PUBLIC_BASE_URL=

# ==================== 可选 ====================

# Session Cookie Secure（启用 HTTPS 后改为 true）
SESSION_COOKIE_SECURE=false

# CORS 允许的前端域名（逗号分隔，用于非 Nginx 代理场景）
MATCHMATE_CORS_ALLOWED_ORIGINS=http://localhost
