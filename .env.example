# ==================== 必填 ====================

# MySQL root 密码
DB_PASSWORD=your_db_password

# Redis 密码
REDIS_PASSWORD=your_redis_password

# ==================== 阿里云 OSS（文件上传） ====================
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_ACCESS_KEY_ID=LTAI5txxxxxxxxxx
OSS_ACCESS_KEY_SECRET=your_oss_secret
OSS_BUCKET_NAME=matchmate-xxx
OSS_PUBLIC_BASE_URL=https://xxx.oss-cn-shenzhen.aliyuncs.com

# ==================== 可选 ====================

# Session Cookie Secure（备案+HTTPS 后改为 true）
SESSION_COOKIE_SECURE=false

# CORS 允许的前端域名（逗号分隔，用于非 Nginx 代理场景）
MATCHMATE_CORS_ALLOWED_ORIGINS=http://localhost
