<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cinoo.matchmateserver.card.mapper.CardRoundMapper">

    <select id="selectMaxRoundNo" resultType="int">
        SELECT COALESCE(MAX(roundNo), 0)
        FROM cardRound
        WHERE roomId = #{roomId}
    </select>

    <select id="selectByRoomId" resultType="com.cinoo.matchmateserver.card.model.entity.CardRound">
        SELECT *
        FROM cardRound
        WHERE roomId = #{roomId}
        ORDER BY createTime DESC
        LIMIT #{limit}
    </select>

</mapper>
