<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cinoo.matchmateserver.mapper.CardExpenseMapper">

    <select id="selectByRoomId" resultType="com.cinoo.matchmateserver.model.domain.CardExpense">
        SELECT *
        FROM cardExpense
        WHERE roomId = #{roomId}
        ORDER BY createTime DESC
        LIMIT #{limit}
    </select>

</mapper>
